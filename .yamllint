extends: default

rules:
  line-length:
    max: 160
  document-start: disable
  truthy:
    allowed-values: ['true', 'false', 'on']
  comments:
    min-spaces-from-content: 1
    # The first line must be exactly "#cloud-config".
    ignore: |
      infra/cloud-init.yaml
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
