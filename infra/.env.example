# Copy to /opt/memories/infra/.env on the server and fill in every value.
# Never commit the real file. Keep an encrypted copy with sops (docs/runbook.md).
#
# Immich containers read this whole file. Do not add names that Immich itself
# uses (IMMICH_*, MACHINE_LEARNING_*, REDIS_*, DB_* other than the ones below):
# for example IMMICH_HOST is Immich's listen address, not our domain.

# --- Domains -----------------------------------------------------------------
# Root domain: custom web UI (placeholder page for now).
DOMAIN=memories.example.com
# Immich subdomain: Immich web, API and mobile app.
PHOTOS_HOST=photos.memories.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=admin@example.com

# --- Google OAuth (Google Cloud console > APIs & Services > Credentials) ------
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# true only for first setup or break-glass. Normal value: false.
PASSWORD_LOGIN_ENABLED=false

# --- Immich storage ----------------------------------------------------------
# Host paths on the data volume (mounted at /srv/photos).
UPLOAD_LOCATION=/srv/photos/library
DB_DATA_LOCATION=/srv/photos/postgres

# --- Immich database ---------------------------------------------------------
# Random, A-Za-z0-9 only: openssl rand -hex 24
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# --- Misc --------------------------------------------------------------------
TZ=Asia/Kolkata
# Docker subnet shared by Caddy and Immich. Change only if it clashes.
EDGE_SUBNET=172.30.0.0/24
